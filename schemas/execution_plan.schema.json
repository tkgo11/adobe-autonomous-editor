{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Video Editing Execution Plan",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "editorPolicy": {
      "type": "string",
      "enum": ["crafting-first", "adobe-only"],
      "default": "crafting-first"
    },
    "report": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": {
          "enum": [
            "filmcraft",
            "effectcraft",
            "premiere",
            "after_effects",
            "desktop",
            "qc",
            "shell",
            "review",
            "analysis",
            "transcribe"
          ]
        },
        "op": { "type": "string" },
        "args": { "type": "object" },
        "argv": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "cwd": { "type": "string" },
        "actions": { "type": "array" },
        "steps": { "type": "array" },
        "continueOnError": { "type": "boolean" },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "retryDelay": {
          "type": "number",
          "minimum": 0
        },
        "verify": {
          "oneOf": [
            { "$ref": "#/$defs/action" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/action" }
            }
          ]
        },
        "fallbacks": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" },
          "maxItems": 8
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": { "const": "shell" }
            },
            "required": ["engine"]
          },
          "then": {
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
