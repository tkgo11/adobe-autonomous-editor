{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "After Effects Autonomous Action Plan",
  "type": "object",
  "required": ["actions"],
  "properties": {
    "undoGroup": {"type": "string"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {"op": {"type": "string"}},
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
