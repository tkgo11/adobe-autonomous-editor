{
  "manifestVersion": 5,
  "id": "com.autonomous-editor.bridge",
  "name": "Autonomous Editor Bridge",
  "version": "0.5.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": ["ws://127.0.0.1:8765", "ws://localhost:8765"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "bridgePanel",
      "label": {"default": "Autonomous Editor Bridge"},
      "minimumSize": {"width": 260, "height": 100},
      "maximumSize": {"width": 2000, "height": 2000},
      "preferredDockedSize": {"width": 360, "height": 150},
      "preferredFloatingSize": {"width": 440, "height": 180}
    }
  ]
}
